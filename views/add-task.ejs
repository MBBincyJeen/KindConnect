<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Add Task</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="topbar">
    <h1>KindConnect</h1>
    <div class="nav">
      <a href="/dashboard">Dashboard</a>
      <a href="/offer-help">Offer Help</a>
      <a href="/your-tasks">Your Tasks</a>
      <a href="/logout">Logout</a>
    </div>
  </header>

  <main class="container">
    <div class="card">
      <h2>Post a New Task</h2>
      <form action="/add-task" method="POST" enctype="multipart/form-data">
        <input name="title" placeholder="Task title" required>
        <textarea name="description" placeholder="Task description" required></textarea>
        <select name="category" required>
          <% categories.forEach(c => { %>
            <option value="<%= c %>"><%= c %></option>
          <% }) %>
        </select>
        <select name="type">
          <option value="In-person">In-person</option>
          <option value="Online">Online</option>
          <option value="Education">Education</option>
        </select>
        <input name="reward" type="number" placeholder="Reward (optional)">
        <label>Attachments (optional)</label>
        <input type="file" name="attachments" multiple>
        <button>Post Task</button>
      </form>
    </div>
  </main>
</body>
</html>
