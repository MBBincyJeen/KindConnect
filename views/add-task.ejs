<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Post a Task — KindConnect</title>
  <meta name="description" content="Post a new task and get help from your community on KindConnect.">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="topbar">
    <h1>KindConnect</h1>
    <div class="nav">
      <a href="/dashboard">Dashboard</a>
      <a href="/offer-help">Offer Help</a>
      <a href="/your-tasks">Your Tasks</a>
      <a href="/logout">Logout</a>
    </div>
  </header>

  <main class="container">
    <div class="card" style="max-width: 640px; margin-left: auto; margin-right: auto;">
      <h2>📝 Post a New Task</h2>
      <form action="/add-task" method="POST" enctype="multipart/form-data">

        <div class="form-group">
          <label for="title">Task Title</label>
          <input id="title" name="title" type="text" placeholder="e.g. Help with grocery shopping" required>
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" placeholder="Describe what you need help with in detail…" required style="min-height:120px;"></textarea>
        </div>

        <div class="form-group">
          <label for="category">Category</label>
          <select id="category" name="category" required>
            <option value="" disabled selected>Choose a category</option>
            <% categories.forEach(c => { %>
              <option value="<%= c %>"><%= c %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="type">Task Type</label>
          <select id="type" name="type">
            <option value="In-person">🏠 In-person</option>
            <option value="Online">💻 Online</option>
            <option value="Education">📚 Education</option>
          </select>
        </div>

        <div class="form-group">
          <label for="reward">Reward (₹) <span style="font-weight:400; color: var(--color-muted);">— optional</span></label>
          <input id="reward" name="reward" type="number" min="0" placeholder="0">
        </div>

        <div class="form-group">
          <label for="attachments">Attachments <span style="font-weight:400; color: var(--color-muted);">— optional, up to 5 files</span></label>
          <input id="attachments" type="file" name="attachments" multiple
            style="padding: 10px 16px; background: #fafbfc; border: 1.5px dashed var(--color-border); cursor: pointer;">
        </div>

        <button type="submit" style="width:100%; margin-top: 8px; padding: 14px;">Post Task →</button>
      </form>
    </div>
  </main>
</body>
</html>
