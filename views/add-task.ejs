<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Add Tutoring Request — KindConnect</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="form-wrap request-form-page">
    <div class="form-card request-form-card">
      <div class="form-heading">
        <div>
          <span class="eyebrow">Student request</span>
          <h2>Post a Tutoring Request</h2>
          <p>Share the learning need, session style, and timing so the right teacher can respond.</p>
        </div>
      </div>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form action="/add-task" method="POST">
        <div class="form-grid">
          <div class="field full">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" required placeholder="Need help with Algebra basics" value="<%= values.title || '' %>">
          </div>

          <div class="field full">
            <label for="description">Description</label>
            <textarea id="description" name="description" required placeholder="Explain what kind of help you need, including chapters, exam goals, or special requirements..."><%= values.description || '' %></textarea>
          </div>

          <div class="field">
            <label for="subject">Subject</label>
            <select id="subject" name="subject" required>
              <option value="">Select subject</option>
              <% subjects.forEach(subject => { %>
                <option value="<%= subject %>" <%= values.subject === subject ? 'selected' : '' %>><%= subject %></option>
              <% }) %>
            </select>
          </div>

          <div class="field">
            <label for="educationLevel">Education Level</label>
            <select id="educationLevel" name="educationLevel" required>
              <option value="">Select level</option>
              <% educationLevels.forEach(level => { %>
                <option value="<%= level %>" <%= values.educationLevel === level ? 'selected' : '' %>><%= level %></option>
              <% }) %>
            </select>
          </div>

          <div class="field">
            <label for="preferredGender">Preferred Gender</label>
            <select id="preferredGender" name="preferredGender">
              <option value="Any" <%= !values.preferredGender || values.preferredGender === 'Any' ? 'selected' : '' %>>Any</option>
              <option value="Male" <%= values.preferredGender === 'Male' ? 'selected' : '' %>>Male</option>
              <option value="Female" <%= values.preferredGender === 'Female' ? 'selected' : '' %>>Female</option>
              <option value="Other" <%= values.preferredGender === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>

          <div class="field">
            <label for="sessionMode">Session Mode</label>
            <select id="sessionMode" name="sessionMode" required>
              <option value="Live" <%= !values.sessionMode || values.sessionMode === 'Live' ? 'selected' : '' %>>Live Online Session</option>
              <option value="In-Person" <%= values.sessionMode === 'In-Person' ? 'selected' : '' %>>In-Person Tutoring</option>
            </select>
          </div>

          <div class="field full">
            <label for="duration">Duration</label>
            <input type="text" id="duration" name="duration" placeholder="Example: 2 weeks, 3 sessions, or 1 hour daily" value="<%= values.duration || '' %>">
          </div>
        </div>

        <div class="submit-row">
          <button type="submit" class="btn btn-primary">Post Request</button>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
