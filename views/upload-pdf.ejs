<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Upload PDF — KindConnect</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container">
    <section class="page-header">
      <h2>Upload PDF Document</h2>
      <p>Upload a PDF and ask questions about its contents later. The app now works with Gemini when available and falls back locally when it is not.</p>
    </section>

    <% if (message) { %>
      <div class="alert"><%= message %></div>
    <% } %>

    <div class="hero-panel card">
      <div class="hero-copy">
        <div class="hero-badge">Smart PDF Q&A</div>
        <h3>Turn documents into searchable knowledge</h3>
        <p>Upload a PDF, let it get indexed, and ask questions instantly from the document content.</p>
      </div>
      <form action="/pdf/upload" method="POST" enctype="multipart/form-data" class="upload-zone">
        <label for="pdfFile" class="upload-label">Choose a PDF file</label>
        <input type="file" name="pdfFile" id="pdfFile" accept="application/pdf" required>
        <button type="submit" class="btn btn-primary">Upload and Index</button>
      </form>
    </div>

    <section class="section">
      <div class="section-header">
        <h3>Your Documents</h3>
      </div>

      <% if (!documents || documents.length === 0) { %>
        <div class="empty-state">
          <p>No uploaded documents yet. Upload a PDF to get started.</p>
        </div>
      <% } else { %>
        <div class="document-list">
          <% documents.forEach(doc => { %>
            <div class="document-card">
              <div class="document-info">
                <strong><%= doc.originalName %></strong>
                <p class="muted">Uploaded: <%= new Date(doc.uploadDate || doc.createdAt).toLocaleString() %></p>
                <p class="muted">Pages: <%= doc.pageCount || 0 %> • Chunks: <%= doc.chunkCount || 0 %></p>
              </div>
              <div class="document-actions">
                <a href="/pdf/<%= doc._id %>/question" class="btn btn-secondary">Ask Question</a>
                <span class="status-pill <%= doc.status === 'ready' ? 'status-pill-success' : 'status-pill-warning' %>"><%= doc.status %></span>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
