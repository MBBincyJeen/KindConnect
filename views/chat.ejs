<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chat Session — KindConnect</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .tone-flag {
      display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.7rem;
      font-weight: 600; margin-left: 4px;
    }
    .tone-flag.urgency { background: #fff3cd; color: #856404; }
    .tone-flag.gratitude { background: #d4edda; color: #155724; }
    .tone-flag.frustration { background: #f8d7da; color: #721c24; }
    .delivery-status { font-size: 0.7rem; margin-left: 4px; }
    .delivery-status.sent { color: #999; }
    .delivery-status.delivered { color: #666; }
    .delivery-status.read { color: #53bdeb; }
    .load-more-btn {
      display: block; margin: 12px auto; padding: 8px 20px;
      background: var(--color-primary, #26a69a); color: #fff; border: none;
      border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 600;
    }
    .load-more-btn:hover { background: #2bbbad; }
    .tone-disclaimer { font-size: 0.7rem; color: #999; font-style: italic; padding: 4px 24px; }
  </style>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container">
    <div class="chat-container" style="max-width: 900px; margin: 20px auto;">
      <!-- Chat Header -->
      <div class="chat-header">
        <div>
          <h2 style="font-size: 1.15rem; margin: 0; padding: 0; border: none; background: none; color: #fff;"><%= task.title %></h2>
          <p style="margin: 4px 0 0 0; font-size: 0.82rem; color: #b0bec5; font-weight: normal;"><%= task.description %></p>
        </div>
        <div class="chat-meta">
          <span class="chat-status-badge <%= task.status === 'In Progress' ? 'in-progress' : 'completed' %>"><%= task.status %></span>
          <div class="chat-sync-status"><div class="chat-sync-dot"></div> Live Session</div>
        </div>
      </div>

      <div class="chat-search-bar">
        <input id="chatSearch" type="search" placeholder="Search chat messages, attachments, summaries..." aria-label="Search chat">
        <button id="clearSearch" type="button">Clear</button>
        <span id="searchCount" class="search-count">0 results</span>
      </div>

      <!-- Chat Messages Container -->
      <div class="chat-box" id="chatBox">
        <% if (typeof hasMore !== 'undefined' && hasMore) { %>
          <button id="loadMoreBtn" class="load-more-btn" data-before="<%= messages.length > 0 ? messages[0]._id : '' %>">Load older messages</button>
        <% } %>
        <% if (messages.length === 0) { %>
          <div class="empty-chat-message">
            <svg viewBox="0 0 24 24" style="width: 52px; height: 52px; fill: #b2dfdb; margin-bottom: 12px;">
              <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/>
            </svg>
            <p>Start your real-time chat connection here!</p>
          </div>
        <% } else { %>
          <% messages.forEach(m => { %>
            <div class="msg <%= m.sender.toString() === currentUserId ? 'me' : 'them' %>" data-search="<%= [m.senderName, m.message, m.fileName, (m.docAnalysis && m.docAnalysis.keywords ? m.docAnalysis.keywords.join(' ') : ''), (m.docAnalysis && m.docAnalysis.aiSummary) || ''].join(' ') %>">
              <div class="msg-header">
                <strong><%= m.senderName || 'User' %></strong>
                <% if (m.toneFlags && m.toneFlags.length > 0) { %>
                  <% m.toneFlags.forEach(flag => { %>
                    <span class="tone-flag <%= flag.type %>"><%= flag.label %></span>
                  <% }) %>
                <% } %>
              </div>
              <p><%= m.message %></p>
              <% if (m.fileUrl) { %>
                <a href="/files/<%= m._id %>" target="_blank" class="attachment-link">Attachment: <%= m.fileName || 'Attachment Document' %></a>
              <% } %>
              <% if (m.docAnalysis && (m.docAnalysis.fileType || m.docAnalysis.wordCount || m.docAnalysis.aiSummary || (m.docAnalysis.keywords && m.docAnalysis.keywords.length))) { %>
                <div class="doc-analysis">
                  <div class="doc-analysis-header"><strong>AI document analysis</strong> • confidence <%= m.docAnalysis.confidence || '0.80' %></div>
                  <% if (m.docAnalysis.fileType) { %><span>Type: <%= m.docAnalysis.fileType %></span><% } %>
                  <% if (m.docAnalysis.wordCount) { %><span>Words: <%= m.docAnalysis.wordCount %></span><% } %>
                  <% if (m.docAnalysis.fileSizeKB) { %><span>Size: <%= m.docAnalysis.fileSizeKB %> KB</span><% } %>
                  <% if (m.docAnalysis.keywords && m.docAnalysis.keywords.length) { %><span>Keywords: <%= m.docAnalysis.keywords.join(', ') %></span><% } %>
                  <% if (m.docAnalysis.aiSummary) { %><div class="doc-summary"><strong>Attachment summary:</strong> <%= m.docAnalysis.aiSummary %></div><% } %>
                </div>
              <% } %>
              <small><%= new Date(m.createdAt || m.timestamp).toLocaleTimeString() %></small>
              <span class="delivery-status <%= m.deliveryStatus || 'sent' %>">
                <% if (m.deliveryStatus === 'read') { %>
                  <span title="Read">&#10003;&#10003;</span>
                <% } else if (m.deliveryStatus === 'delivered') { %>
                  <span title="Delivered">&#10003;&#10003;</span>
                <% } else { %>
                  <span title="Sent">&#10003;</span>
                <% } %>
              </span>
            </div>
          <% }) %>
        <% } %>
      </div>
      
      <!-- Typing Indicator -->
      <div id="typingIndicator" style="padding: 4px 24px; font-size: 0.8rem; color: var(--color-muted); min-height: 20px; font-style: italic;"></div>
      
      <!-- Chat Input Form (supports text + files asynchronously via AJAX FormData) -->
      <form id="chatForm" class="chat-input-form" enctype="multipart/form-data">
        <label class="chat-file-upload-label" title="Attach file" for="fileInput" aria-label="Attach file">
          <span class="icon-paperclip"></span>
          <input type="file" name="file" id="fileInput" class="chat-file-input">
        </label>
        <textarea class="chat-input-textarea" id="messageInput" name="text" placeholder="Type your message here..." rows="1"></textarea>
        <button type="submit" class="chat-send-btn" title="Send message" aria-label="Send message">
          <span class="icon-send"></span>
        </button>
      </form>
      <div id="filePreview" style="padding: 6px 24px; font-size: 0.82rem; color: var(--color-primary); display: none; font-weight: 600; background: #f0f7f7; border-top: 1px solid var(--color-border);"></div>
      <p class="tone-disclaimer">Tone indicators are AI-generated suggestions and may not always reflect true intent. Use them as a guide, not a judgment.</p>
    </div>
  </main>
  
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const taskId = '<%= task._id %>';
    const currentUserId = '<%= currentUserId %>';
    const currentUsername = '<%= username %>';
    const chatBox = document.getElementById('chatBox');
    const form = document.getElementById('chatForm');
    const input = document.getElementById('messageInput');
    const fileInput = document.getElementById('fileInput');
    const filePreview = document.getElementById('filePreview');
    const typingIndicator = document.getElementById('typingIndicator');
    const chatSearch = document.getElementById('chatSearch');
    const clearSearch = document.getElementById('clearSearch');
    const searchCount = document.getElementById('searchCount');
    
    // Join task conversation room
    socket.emit('joinRoom', taskId);
    
    // Auto-scroll to bottom of chat
    chatBox.scrollTop = chatBox.scrollHeight;

    function updateSearchCount(count, total) {
      searchCount.textContent = count === total
        ? `${total} messages`
        : `${count} result${count === 1 ? '' : 's'} of ${total}`;
    }

    function filterMessages() {
      const query = chatSearch.value.trim().toLowerCase();
      const messages = document.querySelectorAll('#chatBox .msg');
      let visible = 0;

      messages.forEach((message) => {
        const text = (message.dataset.search || '').toLowerCase();
        const match = query === '' || text.includes(query);
        message.style.display = match ? '' : 'none';
        if (match) visible += 1;
      });

      updateSearchCount(visible, messages.length);
    }

    chatSearch.addEventListener('input', filterMessages);
    clearSearch.addEventListener('click', () => {
      chatSearch.value = '';
      filterMessages();
      chatSearch.focus();
    });

    filterMessages();
    
    // Auto-expand textarea height based on content
    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = (input.scrollHeight) + 'px';
    });

    // Enter key submits the form, Shift+Enter inputs a new line
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        if (form.requestSubmit) {
          form.requestSubmit();
        } else {
          form.dispatchEvent(new Event('submit', { cancelable: true }));
        }
      }
    });
    
    // Typing indicators
    let typingTimeout;
    input.addEventListener('input', () => {
      socket.emit('typing', { taskId, username: currentUsername });
      clearTimeout(typingTimeout);
      typingTimeout = setTimeout(() => {
        socket.emit('stopTyping', { taskId });
      }, 1500);
    });
    
    socket.on('userTyping', (data) => {
      typingIndicator.textContent = `${data.username} is typing...`;
    });
    
    socket.on('userStopTyping', () => {
      typingIndicator.textContent = '';
    });
    
    // Preview selected file name
    fileInput.addEventListener('change', () => {
      if (fileInput.files.length > 0) {
        filePreview.textContent = `Selected file: ${fileInput.files[0].name}`;
        filePreview.style.display = 'block';
      } else {
        filePreview.style.display = 'none';
      }
    });
    
    // Send Message via AJAX
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text && fileInput.files.length === 0) return;
      
      const formData = new FormData();
      if (text) {
        formData.append('text', text);
      }
      if (fileInput.files.length > 0) {
        formData.append('file', fileInput.files[0]);
      }
      
      try {
        const res = await fetch(`/chat/${taskId}/send`, {
          method: 'POST',
          body: formData,
          credentials: 'include'
        });
        
        const data = await res.json();
        if (data.success) {
          input.value = '';
          input.style.height = 'auto';
          fileInput.value = '';
          filePreview.style.display = 'none';
          socket.emit('stopTyping', { taskId });
          showToast('Message sent successfully');
        }
      } catch(err) {
        console.error(err);
      }
    });
    
    // Pagination: Load older messages
    const loadMoreBtn = document.getElementById('loadMoreBtn');
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', async () => {
        const beforeId = loadMoreBtn.dataset.before;
        if (!beforeId) return;
        try {
          const res = await fetch(`/api/messages/${taskId}?before=${beforeId}&limit=20`);
          const olderMessages = await res.json();
          if (olderMessages.length === 0) {
            loadMoreBtn.textContent = 'No more messages';
            loadMoreBtn.disabled = true;
            return;
          }
          const fragment = document.createDocumentFragment();
          olderMessages.forEach(m => {
            const div = document.createElement('div');
            div.className = `msg ${m.sender.toString() === currentUserId ? 'me' : 'them'}`;
            const searchText = [m.senderName, m.message, m.fileName, m.docAnalysis?.keywords?.join(' ') || '', m.docAnalysis?.aiSummary || ''].join(' ');
            div.dataset.search = searchText;
            const senderName = escapeHtml(m.senderName || 'User');
            const messageText = escapeHtml(m.message || '');
            let toneFlagsHtml = '';
            if (m.toneFlags && m.toneFlags.length > 0) {
              m.toneFlags.forEach(flag => {
                toneFlagsHtml += `<span class="tone-flag ${escapeHtml(flag.type)}">${escapeHtml(flag.label)}</span>`;
              });
            }
            let html = `<div class="msg-header"><strong>${senderName}</strong>${toneFlagsHtml}</div><p>${messageText}</p>`;
            if (m.fileUrl) {
              html += `<a href="/files/${m._id}" target="_blank" class="attachment-link">Attachment: ${escapeHtml(m.fileName || 'Attachment')}</a>`;
            }
            if (m.docAnalysis) {
              html += `<div class="doc-analysis">`;
              if (m.docAnalysis.fileType) html += `<span>Type: ${escapeHtml(m.docAnalysis.fileType)}</span>`;
              if (m.docAnalysis.wordCount) html += `<span>Words: ${m.docAnalysis.wordCount}</span>`;
              if (m.docAnalysis.fileSizeKB) html += `<span>Size: ${m.docAnalysis.fileSizeKB} KB</span>`;
              if (m.docAnalysis.keywords && m.docAnalysis.keywords.length) html += `<span>Keywords: ${escapeHtml(m.docAnalysis.keywords.join(', '))}</span>`;
              if (m.docAnalysis.aiSummary) html += `<div class="doc-summary"><strong>Attachment summary:</strong> ${escapeHtml(m.docAnalysis.aiSummary)}</div>`;
              html += `</div>`;
            }
            const sentAt = m.createdAt || m.timestamp || Date.now();
            html += `<small>${new Date(sentAt).toLocaleTimeString()}</small>`;
            const deliveryStatus = m.deliveryStatus || 'sent';
            let deliveryIcon = '&#10003;';
            if (deliveryStatus === 'read' || deliveryStatus === 'delivered') deliveryIcon = '&#10003;&#10003;';
            html += `<span class="delivery-status ${deliveryStatus}" title="${deliveryStatus.charAt(0).toUpperCase() + deliveryStatus.slice(1)}">${deliveryIcon}</span>`;
            div.innerHTML = html;
            fragment.appendChild(div);
          });
          chatBox.insertBefore(fragment, chatBox.querySelector('.msg'));
          loadMoreBtn.dataset.before = olderMessages[0]._id;
          loadMoreBtn.textContent = 'Load older messages';
        } catch(err) {
          console.error('Failed to load older messages', err);
        }
      });
    }

    // Receive real-time chat messages
    socket.on('newMessage', (msg) => {
      // Remove empty chat state if present
      const emptyState = chatBox.querySelector('.empty-chat-message');
      if (emptyState) emptyState.remove();
      
      const isMe = msg.senderId === currentUserId;
      const div = document.createElement('div');
      div.className = `msg ${isMe ? 'me' : 'them'}`;
      
      const searchText = [msg.senderName, msg.text, msg.fileName, msg.docAnalysis?.keywords?.join(' ') || '', msg.docAnalysis?.aiSummary || ''].join(' ');
      div.dataset.search = searchText;
      const senderName = escapeHtml(msg.senderName || 'User');
      const messageText = escapeHtml(msg.text || '');
      let toneFlagsHtml = '';
      if (msg.toneFlags && msg.toneFlags.length > 0) {
        msg.toneFlags.forEach(flag => {
          toneFlagsHtml += `<span class="tone-flag ${escapeHtml(flag.type)}">${escapeHtml(flag.label)}</span>`;
        });
      }
      const sentAt = msg.createdAt || msg.timestamp || Date.now();
      let html = `<div class="msg-header"><strong>${senderName}</strong>${toneFlagsHtml}</div><p>${messageText}</p>`;
      if (msg.fileUrl) {
        html += `<a href="/files/${escapeHtml(msg._id || msg.messageId || '')}" target="_blank" class="attachment-link">Attachment: ${escapeHtml(msg.fileName || 'Attachment')}</a>`;
      }
      if (msg.docAnalysis) {
        html += `<div class="doc-analysis">`;
        if (msg.docAnalysis.fileType) html += `<span>Type: ${escapeHtml(msg.docAnalysis.fileType)}</span>`;
        if (msg.docAnalysis.wordCount) html += `<span>Words: ${msg.docAnalysis.wordCount}</span>`;
        if (msg.docAnalysis.fileSizeKB) html += `<span>Size: ${msg.docAnalysis.fileSizeKB} KB</span>`;
        if (msg.docAnalysis.keywords && msg.docAnalysis.keywords.length) html += `<span>Keywords: ${escapeHtml(msg.docAnalysis.keywords.join(', '))}</span>`;
        if (msg.docAnalysis.aiSummary) html += `<div class="doc-summary"><strong>Attachment summary:</strong> ${escapeHtml(msg.docAnalysis.aiSummary)}</div>`;
        html += `</div>`;
      }
      html += `<small>${new Date(sentAt).toLocaleTimeString()}</small>`;
      const deliveryStatus = msg.deliveryStatus || 'sent';
      let deliveryIcon = '&#10003;';
      if (deliveryStatus === 'read' || deliveryStatus === 'delivered') deliveryIcon = '&#10003;&#10003;';
      html += `<span class="delivery-status ${deliveryStatus}" title="${deliveryStatus.charAt(0).toUpperCase() + deliveryStatus.slice(1)}">${deliveryIcon}</span>`;
      
      div.innerHTML = html;
      chatBox.appendChild(div);
      filterMessages();
      
      // Emit delivery confirmation for messages from others
      if (!isMe) {
        socket.emit('messageDelivered', { messageId: msg._id || msg.messageId, taskId });
      }

      // Auto-scroll on new message
      chatBox.scrollTop = chatBox.scrollHeight;
    });

    // Socket.IO reconnect handling
    socket.on('connect', () => {
      socket.emit('joinRoom', taskId);
    });

    socket.on('disconnect', (reason) => {
      typingIndicator.textContent = 'Reconnecting...';
    });

    socket.on('reconnect', () => {
      socket.emit('joinRoom', taskId);
      typingIndicator.textContent = '';
    });
    
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function showToast(message) {
      const toast = document.createElement('div');
      toast.className = 'chat-toast';
      toast.textContent = message;
      document.body.appendChild(toast);
      setTimeout(() => toast.classList.add('show'), 10);
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }
  </script>
</body>
</html>
