<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Chat</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="topbar">
    <h1>KindConnect</h1>
    <div class="nav">
      <a href="/dashboard">Dashboard</a>
      <a href="/your-tasks">Your Tasks</a>
      <a href="/offer-help">Offer Help</a>
      <a href="/logout">Logout</a>
    </div>
  </header>

  <main class="container">
    <h2>Chat for: <%= task.title %></h2>
    <p>Poster: <%= task.postedByName %> | Helper: <%= task.takenByName %></p>

    <div class="chat-box">
      <% if (!task.messages || task.messages.length === 0) { %>
        <p>No messages yet.</p>
      <% } else { %>
        <% task.messages.forEach(m => { %>
          <div class="msg <%= m.senderName === username ? 'me' : 'them' %>">
            <p><strong><%= m.senderName %></strong> <small><%= new Date(m.createdAt).toLocaleString() %></small></p>
            <% if (m.text) { %><p><%= m.text %></p><% } %>
            <% if (m.file) { %><p><a href="<%= m.file %>" target="_blank">Attachment</a></p><% } %>
          </div>
        <% }) %>
      <% } %>
    </div>

    <form action="/chat/<%= task._id %>" method="POST" enctype="multipart/form-data">
      <textarea name="text" placeholder="Write a message"></textarea><br>
      <input type="file" name="file"><br>
      <button>Send</button>
    </form>

  </main>
</body>
</html>
