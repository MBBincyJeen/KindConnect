<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard — KindConnect</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container">
    <div class="profile-banner <%= role === "Teacher" ? "profile-banner-rated" : "" %>">
      <% if (role === "Teacher") { %>
        <div class="teacher-rating-corner">
          <strong><%= teacherRating && teacherRating.average !== null ? teacherRating.average : '—' %>/5</strong>
          <span><%= teacherRating && teacherRating.count ? teacherRating.count : 0 %> anonymous rating<%= teacherRating && teacherRating.count === 1 ? '' : 's' %></span>
        </div>
      <% } %>
      <div class="profile-avatar"><%= username.charAt(0).toUpperCase() %></div>
      <div class="profile-info">
        <div class="profile-top">
          <div>
            <h2><%= fullName %></h2>
            <p class="profile-subtitle"><%= role %> • Level <%= educationLevel %></p>
          </div>
          <span class="status-pill <%= aadhaarVerified ? 'status-pill-success' : 'status-pill-warning' %>"><%= aadhaarVerified ? 'Aadhaar verified' : 'Aadhaar unverified' %></span>
        </div>

        <div class="profile-details">
          <div><strong>Gender</strong><span><%= gender %></span></div>
          <% if (role === "Teacher" && subjects && subjects.length > 0) { %>
            <div><strong>Subjects</strong><span><%= subjects.join(', ') %></span></div>
          <% } %>
          <div><strong>Location</strong><span id="locationText"><%= location || 'Detecting location...' %></span></div>
        </div>
      </div>
    </div>

    <section>
      <div class="section-header">
        <h2>Your Active Posts <span class="count-badge"><%= posted.length %></span></h2>
      </div>

      <% if (posted.length === 0) { %>
        <div class="empty-state">
          <% if (role === "Student") { %>
            <p>No active posts. <a href="/add-task">Create a tutoring request now →</a></p>
          <% } else { %>
            <p>No tutoring requests posted by you yet.</p>
          <% } %>
        </div>
      <% } %>

      <% posted.forEach(t => { %>
        <div class="task">
          <div class="task-top">
            <h3><%= t.title %></h3>
            <span class="status-badge <%= t.status === 'Not Taken' ? 'status-not-taken' : t.status === 'In Progress' ? 'status-in-progress' : 'status-completed' %>">
              <%= t.status %>
            </span>
          </div>
          <% if (t.aiSummary) { %>
            <div class="ai-review-panel">
              <div class="ai-review-label">AI summary</div>
              <p><%= t.aiSummary %></p>
              <span class="safety-pill <%= t.aiSafetyCheck && t.aiSafetyCheck.isSafe ? 'safety-safe' : 'safety-review' %>">
                <%= t.aiSafetyCheck && t.aiSafetyCheck.isSafe ? 'Safe to publish' : 'Needs review' %>
              </span>
            </div>
          <% } else { %>
            <p><%= t.description %></p>
          <% } %>
          <div class="task-meta">
            <span class="tag tag-category">Subject: <%= t.subject %></span>
            <span class="tag tag-type">Grade: <%= t.educationLevel %></span>
            <span class="tag tag-reward">Pref. Gender: <%= t.preferredGender %></span>
            <span class="tag tag-type">Mode: <%= (t.sessionMode || "Live") === "Live" ? "Online" : "Offline" %></span>
            <% if (t.duration) { %><span class="tag tag-reward">Duration: <%= t.duration %></span><% } %>
          </div>
          <div class="task-actions">
            <% if (t.status === "In Progress" && t.takenById) { %>
              <a href="/chat/<%= t._id %>" class="btn btn-chat">Open</a>
              <% if ((t.sessionMode || "Live") === "Live") { %>
                <a href="/session/<%= t._id %>" class="btn btn-primary">Session</a>
              <% } %>
              <span class="task-note">Matched with <strong><%= t.takenByName %></strong></span>
            <% } else if (t.status === "Not Taken") { %>
              <a href="/recommendations/<%= t._id %>" class="btn btn-primary">Review</a>
            <% } %>

            <% if (role === "Student" && t.status !== "Completed") { %>
              <% if (t.status === "In Progress" && t.takenById && t.studentAccepted) { %>
                <div class="task-evaluation-action">
                  <button type="button" class="btn btn-secondary">Mark Complete</button>
                  <form action="/complete-task/<%= t._id %>" method="POST" class="rating-complete-form">
                    <div class="rating-complete-grid">
                      <% ['clarity', 'helpfulness', 'professionalism', 'engagement'].forEach(metric => { %>
                        <label>
                          <span><%= metric.charAt(0).toUpperCase() + metric.slice(1) %></span>
                          <select name="<%= metric %>" required>
                            <option value="">Rate</option>
                            <% [5, 4, 3, 2, 1].forEach(score => { %>
                              <option value="<%= score %>"><%= score %></option>
                            <% }) %>
                          </select>
                        </label>
                      <% }) %>
                    </div>
                    <button type="submit" class="btn btn-secondary">Submit Evaluation & Complete</button>
                  </form>
                </div>
              <% } else { %>
                <form action="/complete-task/<%= t._id %>" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-secondary">Complete</button>
                </form>
              <% } %>
            <% } %>

            <% if (role === "Student") { %>
              <form action="/delete-task/<%= t._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this post?')">
                <button type="submit" class="btn btn-danger">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </section>

    <!-- Recent community posts removed for a cleaner dashboard experience -->
  </main>

  <script>
    async function reverseGeocode(lat, lng) {
      try {
        const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`;
        const res = await fetch(url, { headers: { "Accept": "application/json" } });
        const data = await res.json();
        return data.address?.city || data.address?.town || data.address?.village || data.display_name || "Unknown";
      } catch {
        return "Unknown";
      }
    }

    async function saveLocation(lat, lng, locationName) {
      try {
        await fetch("/save-location", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ lat, lng, locationName }),
        });
        document.getElementById("locationText").textContent = locationName;
      } catch {}
    }

    function getCurrentLocation() {
      if (!navigator.geolocation) return;
      navigator.geolocation.getCurrentPosition(async (position) => {
        const lat = position.coords.latitude;
        const lng = position.coords.longitude;
        const locationName = await reverseGeocode(lat, lng);
        await saveLocation(lat, lng, locationName);
      });
    }

    window.addEventListener("load", getCurrentLocation);
  </script>
</body>
</html>
