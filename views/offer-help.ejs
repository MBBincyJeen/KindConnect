<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Browse Tutoring — KindConnect</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container">
    <div class="section-header">
      <h2>
        Tutoring Posts
        <span class="count-badge"><%= (tasks && tasks.length) ? tasks.length : 0 %></span>
      </h2>
    </div>

    <% if (!tasks || tasks.length === 0) { %>
      <div class="empty-state">
        <p>No tutoring posts available right now. Check back soon!</p>
      </div>
    <% } else { %>
      <% tasks.forEach(t => { %>
        <div class="task">
          <div class="task-top">
            <h3><%= t.title %></h3>
            <span class="status-badge <%= t.status === 'Not Taken' ? 'status-not-taken' : 'status-in-progress' %>">
              <%= t.status %>
            </span>
          </div>

          <% if (t.aiSummary) { %>
            <div class="ai-review-panel">
              <div class="ai-review-label">AI summary</div>
              <p><%= t.aiSummary %></p>
            </div>
          <% } else { %>
            <p><%= t.description %></p>
          <% } %>

          <div class="task-meta">
            <span class="tag tag-category"><%= t.subject %></span>
            <span class="tag tag-type">Level: <%= t.educationLevel %></span>
            <span class="tag tag-type">Mode: <%= (t.sessionMode || "Live") === "Live" ? "Online" : "Offline" %></span>
            <% if (t.duration) { %><span class="tag tag-reward">Duration: <%= t.duration %></span><% } %>
            <span class="tag tag-category">Posted by: <%= t.postedByName %> (<%= t.postedByRole %>)</span>
          </div>

          <div class="task-actions">
            <% if (t.status === "Not Taken") { %>
              <form action="/take-task/<%= t._id %>" method="POST">
                <button type="submit" class="btn btn-primary">Take This</button>
              </form>
            <% } else if (t.takenById && currentUser && t.takenById.toString() === currentUser.id) { %>
              <% if (t.studentAccepted) { %>
                <a href="/chat/<%= t._id %>" class="btn btn-chat">Open Chat</a>
                <% if ((t.sessionMode || "Live") === "Live") { %>
                  <a href="/session/<%= t._id %>" class="btn btn-primary">Start Live Session</a>
                <% } %>
              <% } else { %>
                <span style="font-size: 0.85rem; color: var(--color-muted);">Awaiting student connection</span>
              <% } %>
            <% } else { %>
              <span style="font-size:0.85rem; color: var(--color-muted);">Being handled by <%= t.takenByName %></span>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </main>
</body>
</html>
