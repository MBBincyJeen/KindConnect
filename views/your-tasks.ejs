<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Your Tasks</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="topbar">
    <h1>KindConnect</h1>
    <div class="nav">
      <a href="/dashboard">Dashboard</a>
      <a href="/add-task">Post Task</a>
      <a href="/offer-help">Offer Help</a>
      <a href="/logout">Logout</a>
    </div>
  </header>

  <main class="container">
    <h2>Tasks You Accepted</h2>
    <% if (!tasks || tasks.length === 0) { %>
      <p>You have not accepted any tasks.</p>
    <% } %>

    <% tasks.forEach(t => { %>
      <div class="task">
        <h3><%= t.title %></h3>
        <p><%= t.description %></p>
        <p><strong>Posted by:</strong> <%= t.postedByName %></p>
        <p><strong>Status:</strong> <%= t.status %></p>
        <a href="/chat/<%= t._id %>">Open Chat</a>
      </div>
    <% }) %>
  </main>
</body>
</html>
